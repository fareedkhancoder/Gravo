<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/gravo_cart_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/gravo_cart_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/productImageViewCart"
            android:layout_width="80dp"
            android:layout_height="104dp"
            android:background="@color/gravo_cart_image_background"
            android:contentDescription="@string/gravo_cart_product_image_content_description"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/productNameTextViewCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="@color/gravo_cart_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Premium Basmati Rice — 1 kg pack" />

                <!-- Keep removeContainer and deleteAddressButton IDs for the existing adapter. -->
                <LinearLayout
                    android:id="@+id/removeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/gravo_cart_remove_item_content_description"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:id="@+id/deleteAddressButton"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/gravo_cart_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="@string/gravo_cart_remove"
                        android:textColor="@color/gravo_cart_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/productPriceTextViewCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gravo_cart_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="₹249.00" />

                <TextView
                    android:id="@+id/multiplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="× 1"
                    android:textColor="@color/gravo_cart_text_secondary"
                    android:textSize="12sp"
                    tools:text="× 2" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_order_status_pill"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="#B42318"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Out of Stock"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gravo_cart_line_total"
                    android:textColor="@color/gravo_cart_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/totalPriceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/gravo_cart_blue_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="₹498.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Keep quantitySelector, minusButton, quantityTextView and PlusBtn IDs. -->
                <LinearLayout
                    android:id="@+id/quantitySelector"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_cart_quantity_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <ImageButton
                        android:id="@+id/minusButton"
                        android:layout_width="34dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/gravo_cart_decrease_quantity"
                        android:padding="1dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_down_arrow"
                        app:tint="@color/gravo_cart_blue" />

                    <TextView
                        android:id="@+id/quantityTextView"
                        android:layout_width="30dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/gravo_cart_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2" />

                    <ImageButton
                        android:id="@+id/PlusBtn"
                        android:layout_width="34dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/gravo_cart_increase_quantity"
                        android:padding="1dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/outline_arrow_drop_up_24"
                        app:tint="@color/gravo_cart_blue" />
                </LinearLayout>

                <!-- Keep this ID; wire it to the wishlist feature if that data flow exists. -->
                <TextView
                    android:id="@+id/saveInWishlistButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/gravo_cart_save_for_later_content_description"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="44dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/gravo_cart_save"
                    android:textColor="@color/gravo_cart_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
