<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_accent_sky_blue">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

        <!-- Top app bar -->

        <!-- Profile block -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:background="@color/dialog_accent_sky_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:gravity="start"
                android:text="Your Profile"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/notification"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/notification" />

            <FrameLayout
                android:id="@+id/notification"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMenu"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notification"
                    android:scaleType="centerInside"
                    android:src="@drawable/bell" />
                <TextView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:visibility="visible"
                    android:includeFontPadding="false"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="15dp"
                android:contentDescription="More"
                android:src="@drawable/ic_menu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#111111" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profileBlock"
            android:layout_width="0dp"
            android:background="@color/white"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="8dp">

            <FrameLayout
                android:id="@+id/avatarWrap"
                android:layout_width="76dp"
                android:layout_height="92dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="Profile picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photo_placeholder" />

                <TextView
                    android:id="@+id/tvCurious"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_speech"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Just\ncurious..."
                    android:textColor="#8F8F8F"
                    android:textSize="11sp"
                    android:lineSpacingExtra="-1dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="37dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_speech_tail" />

                <ImageView
                    android:id="@+id/ivAvatarAdd"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/bg_circle_black"
                    android:contentDescription="Add story"
                    android:padding="4dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="Fareed Khan"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/avatarWrap"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="9dp"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/stats"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/tvName"
                app:layout_constraintStart_toEndOf="@id/avatarWrap"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="9dp"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="5" android:textColor="#111111" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="posts" android:textColor="#111111" android:textSize="14sp" android:layout_marginTop="1dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="76" android:textColor="#111111" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="followers" android:textColor="#111111" android:textSize="14sp" android:layout_marginTop="1dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="89" android:textColor="#111111" android:textSize="15sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="following" android:textColor="#111111" android:textSize="14sp" android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:text="Phone No: +919027958861"
            android:textColor="#222222"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/profileBlock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/musicRow"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvBio"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_play_outline"
                app:tint="#111111"
                android:contentDescription="Play" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Random Switch (remix)"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="7dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Carpe Diem"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_marginStart="9dp" />
            <TextView
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/bg_add_pill"
                android:text="+ Add"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/musicRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="9dp">

            <TextView
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_action"
                android:text="Track Orders"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_action"
                android:text="Edit Profile"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="7dp" />

            <ImageView
                android:id="@+id/btnPersonAdd"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_action"
                android:src="@drawable/ic_person_add"
                app:tint="#111111"
                android:contentDescription="Add person"
                android:layout_marginStart="7dp" />
        </LinearLayout>

        <!-- Tabs -->
        <FrameLayout
            android:id="@+id/tabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actionRow"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="horizontal">

                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_grid" app:tint="#111111" android:contentDescription="Posts" />
                    <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_gravity="bottom" android:background="#111111" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_reels" app:tint="#777777" android:contentDescription="Reels" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_repeat" app:tint="#777777" android:contentDescription="Reposts" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_tagged" app:tint="#777777" android:contentDescription="Tagged" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Photo grid -->
        <ScrollView
            android:id="@+id/gridScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="159dp" android:orientation="horizontal">
                    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerCrop" android:src="@drawable/photo_placeholder" android:contentDescription="Post 1" />
                    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:scaleType="centerCrop" android:src="@drawable/photo_placeholder" android:contentDescription="Post 2" />
                    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:scaleType="centerCrop" android:src="@drawable/photo_placeholder" android:contentDescription="Post 3" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="159dp" android:orientation="horizontal" android:layout_marginTop="2dp">
                    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerCrop" android:src="@drawable/photo_placeholder" android:contentDescription="Post 4" />
                    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:scaleType="centerCrop" android:src="@drawable/photo_placeholder" android:contentDescription="Post 5" />
                    <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:background="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
